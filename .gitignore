# env — secrets live ONLY in .env.local (never committed) or Vercel env settings
.env
.env.*
!.env.example

# dependencies
node_modules/
/.pnp
.pnp.*

# next.js / build output
.next/
out/
dist/
build/

# testing
coverage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials / key material (belt and braces — none should ever exist here)
*.pem
*.key
serviceAccount*.json
credentials*.json
token*.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local databases
*.sqlite
*.db

# tooling / OS
.claude/
__pycache__/
.DS_Store

# Local pilot state and Python environments; never commit applicant/session data.
.venv*/
.local-data/
.pytest_cache/
.playwright/
test-results/
playwright-report/
