# Copy to .env.local and fill in your own values. NEVER commit .env.local.
# See README.md "Configuration" for where to obtain each value.

# Firebase client config (Firebase console > Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (service account, used only by server-side routes e.g. the Flow webhook)
# Generate at: Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Flow.cl (https://www.flow.cl) — sandbox or production API credentials
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_BASE_URL=https://sandbox.flow.cl/api
FLOW_PLAN_AMOUNT=9990
FLOW_PLAN_NAME=TurboTrabajo Mensual

# Public base URL of this app, used to build Flow confirmation/return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CV intake by email. Server-only — never prefix NEXT_PUBLIC_.
# Gmail App Password: enable 2FA on the Gmail account, then create an App Password
# at https://myaccount.google.com/apppasswords. If GMAIL_* are unset in dev, the
# app falls back to an Ethereal test inbox and logs a preview URL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where uploaded CVs are emailed (the operator's inbox).
OWNER_CV_INBOX=
