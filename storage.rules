rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // CV files live at cvs/{uid}/original-v{n}.pdf and cvs/{uid}/improved-v{n}.pdf.
    // The team uploads "improved-*" files from the Firebase Storage console
    // using the Admin SDK / console UI, which bypasses these rules.
    match /cvs/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && fileName.matches("original-v[0-9]+\\.pdf")
        && request.resource.contentType == "application/pdf"
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
