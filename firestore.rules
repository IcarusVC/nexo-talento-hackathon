rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The HITL team and the Flow webhook use the Admin SDK, which bypasses
    // these rules entirely. Everything below applies only to client app users.

    // A client may only ever move their own cv.status into one of these
    // values, and only from the matching prior status. The team (console,
    // Admin SDK) is the only writer of "mejorado_por_revisar" and bypasses
    // this check entirely.
    function isAllowedClientCvTransition(prevStatus, nextStatus) {
      return (nextStatus == "pendiente_mejora")
        || (nextStatus == "aprobado" && prevStatus == "mejorado_por_revisar")
        || (nextStatus == "cambios_solicitados" && prevStatus == "mejorado_por_revisar");
    }

    // Server-only throttle state for the CV intake route. Written exclusively by the
    // Admin SDK (which bypasses these rules); denied to every client so the rate limit
    // cannot be reset by the account it is limiting.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // On signup a client may only grant themselves the fixed trial wallet
      // (must match SIGNUP_TRIAL_TOKENS in src/lib/constants.ts): exactly 5 tokens,
      // 0 reserved. They can never mint extra tokens this way.
      //
      // Trial tokens require a VERIFIED email. Each one buys a human-performed job
      // application, so without this an attacker scripts N signups against disposable
      // or unowned addresses and harvests 5 tokens each, unbounded. Unverified accounts
      // are still created (so onboarding works) — just with an empty wallet, and the
      // client tops it up after verifying. Google/OAuth sign-ins arrive verified.
      allow create: if isOwner(uid)
        && request.resource.data.role == "client"
        && request.resource.data.wallet.balance ==
             (request.auth.token.email_verified == true ? 5 : 0)
        && request.resource.data.wallet.reserved == 0
        && request.resource.data.cv.status == "pendiente_mejora";

      // Clients may update their own profile/cv, but NEVER their own wallet —
      // tokens are credited only by the Flow webhook and spent only by server
      // routes (Admin SDK), both of which bypass these rules.
      //
      // A plain profile/preferences save leaves cv.status untouched, so the
      // rule must allow a no-op status; only when cv.status actually CHANGES
      // do we require it to be a valid client transition. (Previously any
      // update was rejected once cv.status left "pendiente_mejora", which
      // permanently broke /preferences for every user with an improved or
      // approved CV.)
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.wallet == resource.data.wallet
        && (
          request.resource.data.cv.status == resource.data.cv.status
          || isAllowedClientCvTransition(resource.data.cv.status, request.resource.data.cv.status)
        );

      allow delete: if false;

      // Token ledger: server-written audit trail. Owner reads, never writes.
      match /tokenLedger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow write: if false; // team only, via console (Admin SDK)

      match /prep/{prepId} {
        allow read: if isSignedIn();
        allow write: if false; // team only, via console (Admin SDK)
      }
    }

    match /applications/{appId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Workstream C: applications are server-authoritative. Opt-in goes
      // through POST /api/applications (reserves 1 token atomically) and
      // withdraw through POST /api/applications/withdraw (releases it) —
      // both via the Admin SDK, which bypasses these rules. Team status
      // transitions use scripts/application-set-status.ts. Direct client
      // writes would desync the wallet, so they are fully denied.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Flow webhook only, via Admin SDK
    }
  }
}
